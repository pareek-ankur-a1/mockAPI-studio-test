# Environment variables for the Dynamic API Mocking Service
# Copy this file to .env and fill in your values

# --- Server ---
PORT=5000
NODE_ENV=development

# --- MongoDB ---
# Replace with your MongoDB Atlas connection string or local URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mock-api-service?retryWrites=true&w=majority

# --- Redis ---
# Set the connection URL from your Redis Cloud database (use rediss:// for TLS).
# Required in production. Leave blank in development for memory limits/no caching.
REDIS_URL=
# Example: redis://default:URL_ENCODED_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT
# Use the same prefix on replicas; use different prefixes for separate environments.
REDIS_KEY_PREFIX=mockapi:
# Successful mock GET responses expire after this many seconds (1-3600).
MOCK_CACHE_TTL_SECONDS=30
# Set only when deployed behind a known, fixed number of reverse proxies.
TRUST_PROXY_HOPS=0

# --- CORS ---
# Frontend URL (used for dashboard CORS policy; mock engine allows all origins)
CLIENT_URL=http://localhost:5173

# --- JWT Authentication ---
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_byte_hex_secret
JWT_EXPIRES_IN=7d

# --- Email / OTP (Brevo HTTPS API) ---
# Use an API key, not an SMTP key. EMAIL_FROM must be a verified Brevo sender.
BREVO_API_KEY=
EMAIL_FROM=
